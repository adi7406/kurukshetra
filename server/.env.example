# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration
# Replace with your project credentials; never commit real secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key

# Storage Configuration
STORAGE_BUCKET=private-learning-documents

# Optional Integrations
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=

# NVIDIA AI Models Configuration (https://integrate.api.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_SECONDARY_MODEL=openai/gpt-oss-20b

# Self-Hosted Piston Execution Service (https://github.com/engineer-man/piston)
# PISTON_BASE_URL=http://127.0.0.1:2000
# PISTON_REQUEST_TIMEOUT_MS=10000
# PISTON_MAX_SOURCE_BYTES=65536
# PISTON_DEFAULT_MEMORY_LIMIT_KB=128000
# PISTON_DEFAULT_CPU_TIME_MS=3000
